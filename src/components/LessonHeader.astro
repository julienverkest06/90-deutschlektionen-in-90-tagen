<div class="bg-white rounded-2xl border border-gray-200 p-5 sm:p-6 shadow-xs mb-6 relative overflow-hidden">
  <div class="absolute top-0 left-0 w-1.5 h-full bg-de-red"></div>

  <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
    <div class="flex items-center gap-2 flex-wrap">
      <span id="lesson-badge-num" class="px-2.5 py-1 rounded-lg bg-de-black text-white text-xs font-extrabold tracking-wide">
        LEÇON 1
      </span>
      <span id="lesson-series-label" class="text-xs font-medium text-gray-500 bg-gray-100 px-2.5 py-1 rounded-lg">
        Série 1 • Éléments de base
      </span>
      <span id="lesson-authentic-badge" class="hidden text-xs font-semibold text-amber-800 bg-amber-100 border border-amber-200 px-2 py-0.5 rounded-lg">
        📖 Extrait intégral du livre
      </span>
    </div>
    <div id="lesson-stars-display" class="flex items-center gap-1 text-sm"></div>
  </div>

  <h2 id="lesson-title-de" class="font-serif text-2xl sm:text-3xl font-bold text-de-black mt-1">
    Er lernt im Park
  </h2>
  <p id="lesson-title-fr" class="text-sm sm:text-base text-gray-600 font-medium mt-0.5">
    Il apprend dans le parc
  </p>

  <!-- Proverbe allemand de la leçon -->
  <div id="lesson-proverb-box" class="mt-4 pt-3 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
    <div class="flex items-center gap-2">
      <span class="px-2 py-0.5 rounded bg-de-gold/30 text-de-black font-bold">Dicton</span>
      <span id="lesson-proverb-de" class="font-semibold italic text-de-black">Aller Anfang ist schwer.</span>
    </div>
    <span id="lesson-proverb-fr" class="text-gray-500">Tout commencement est difficile.</span>
  </div>
</div>
