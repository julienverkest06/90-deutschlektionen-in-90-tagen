<div class="bg-white border border-stone-300 p-5 sm:p-6 mb-6 relative overflow-hidden">
  <div class="absolute top-0 left-0 w-1 h-full bg-de-red"></div>

  <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
    <div class="flex items-center gap-2 flex-wrap">
      <span id="lesson-badge-num" class="px-2.5 py-1 bg-de-black text-de-cream text-[11px] font-bold tracking-widest uppercase">
        LEÇON 1
      </span>
      <span id="lesson-series-label" class="text-xs font-medium text-stone-600 bg-de-cream border border-stone-200 px-2.5 py-1">
        Série 1 · Éléments de base
      </span>
      <span id="lesson-authentic-badge" class="hidden text-xs font-semibold text-de-black bg-de-gold-light border border-de-gold/40 px-2.5 py-0.5">
        ⁋ Extrait intégral du livre
      </span>
    </div>
    <div id="lesson-stars-display" class="flex items-center gap-1 text-sm"></div>
  </div>

  <h2 id="lesson-title-de" class="font-serif text-2xl sm:text-3xl font-bold text-de-black mt-1 tracking-tight">
    Er lernt im Park
  </h2>
  <p id="lesson-title-fr" class="text-sm sm:text-base text-stone-600 font-medium mt-0.5">
    Il apprend dans le parc
  </p>

  <!-- Proverbe allemand de la leçon -->
  <div id="lesson-proverb-box" class="mt-4 pt-3 border-t border-stone-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
    <div class="flex items-center gap-2">
      <span class="px-2 py-0.5 border border-stone-300 bg-de-cream text-stone-700 font-semibold uppercase tracking-wider text-[10px]">
        Dicton
      </span>
      <span id="lesson-proverb-de" class="font-serif font-semibold italic text-sm text-de-black">
        Eile mit Weile.
      </span>
    </div>
    <span id="lesson-proverb-fr" class="text-stone-500">Hâte-toi lentement (Hâte-toi avec loisir).</span>
  </div>
</div>
