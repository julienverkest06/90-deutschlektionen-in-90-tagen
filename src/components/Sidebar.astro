---
import { LESSON_ORDER } from '@data/syllabus';
---

<!-- Overlay mobile pour la barre latérale -->
<div
  id="sidebar-overlay"
  class="fixed inset-0 bg-black/40 z-30 hidden lg:hidden backdrop-blur-xs"
></div>

<!-- Barre latérale de navigation (Les 90 leçons + 7 bis) -->
<aside
  id="sidebar"
  class="fixed lg:sticky top-[4.25rem] left-0 z-30 w-80 h-[calc(100vh-4.25rem)] bg-white border-r border-stone-300 flex flex-col transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out"
>
  <!-- Recherche & Mode Exploration -->
  <div class="p-3.5 border-b border-stone-200 space-y-2.5 bg-de-cream/70">
    <div class="relative">
      <input
        type="text"
        id="lesson-search"
        placeholder="Rechercher leçon, thème (ex: datif)..."
        class="w-full pl-8 pr-3 py-2 text-xs bg-white border border-stone-300 focus:outline-none focus:border-de-black transition"
      />
      <span class="text-stone-400 text-xs absolute left-3 top-2.5 pointer-events-none" aria-hidden="true">⌖</span>
    </div>

    <div class="flex items-center justify-between text-[11px]">
      <span id="progress-summary" class="font-semibold text-stone-600 tabular-nums">0 / {LESSON_ORDER.length} complétées</span>
      <button
        id="unlock-mode-btn"
        type="button"
        class="px-2 py-1 font-semibold border transition flex items-center gap-1.5 cursor-pointer"
      ></button>
    </div>
  </div>

  <!-- Filtres par Série -->
  <div class="grid grid-cols-4 border-b border-stone-200 bg-white text-[11px] font-semibold divide-x divide-stone-200">
    <button id="filter-all" data-series-filter="all" type="button" class="py-2 bg-de-black text-white transition cursor-pointer">
      Toutes
    </button>
    <button id="filter-1" data-series-filter="1" type="button" class="py-2 text-stone-600 hover:bg-stone-100 transition cursor-pointer">
      Série 1
    </button>
    <button id="filter-2" data-series-filter="2" type="button" class="py-2 text-stone-600 hover:bg-stone-100 transition cursor-pointer">
      Série 2
    </button>
    <button id="filter-3" data-series-filter="3" type="button" class="py-2 text-stone-600 hover:bg-stone-100 transition cursor-pointer">
      Série 3
    </button>
  </div>

  <!-- Liste scrollable des leçons -->
  <div id="lessons-list" class="flex-1 overflow-y-auto p-2 space-y-0.5"></div>

  <!-- Pied de barre latérale -->
  <div class="p-3 border-t border-stone-200 bg-de-cream flex items-center justify-between text-[11px] text-stone-500">
    <span>Édition Le Livre de Poche</span>
    <button id="reset-progress-btn" type="button" class="text-de-red hover:underline font-medium cursor-pointer">
      Réinitialiser
    </button>
  </div>
</aside>
