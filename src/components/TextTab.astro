---
---

<section id="tab-content-text" class="space-y-6 animate-pop">
  <div class="bg-white border border-stone-300 p-5 sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-5 border-b border-stone-200">
      <div>
        <h3 class="font-bold text-base text-de-black">Texte allemand et traduction juxtalinéaire</h3>
        <p class="text-xs text-stone-500">
          Cliquez sur un paragraphe ou sur le symbole ♪ pour écouter la prononciation allemande.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <button
          id="speak-full-lesson-btn"
          type="button"
          class="px-3.5 py-2 bg-de-black hover:bg-stone-800 text-de-cream text-xs font-semibold flex items-center gap-2 transition cursor-pointer"
        >
          <span aria-hidden="true">♫</span>
          <span>Tout écouter</span>
        </button>
        <button
          id="toggle-trans-btn"
          type="button"
          class="px-3 py-2 border border-stone-300 hover:bg-stone-100 text-xs font-semibold text-stone-700 transition cursor-pointer"
        >
          Masquer français
        </button>
      </div>
    </div>

    <div id="lesson-paragraphs" class="space-y-3"></div>
  </div>

  <!-- Note de Prononciation -->
  <div id="pronunciation-card" class="bg-de-gold-light border border-stone-300 border-l-2 border-l-de-gold p-5">
    <div class="flex items-center gap-2 mb-2">
      <span class="text-base text-de-gold font-bold" aria-hidden="true">※</span>
      <h4 class="font-bold text-xs uppercase tracking-wider text-de-black">Prononciation & Accent tonique</h4>
    </div>
    <p id="lesson-pronunciation" class="text-xs sm:text-sm text-stone-700 leading-relaxed"></p>
  </div>

  <div class="flex justify-end">
    <button
      data-switch-tab="vocab"
      type="button"
      class="px-5 py-3 bg-de-black hover:bg-stone-800 text-de-cream text-sm font-semibold transition flex items-center gap-2 cursor-pointer"
    >
      <span>Continuer vers le Vocabulaire & la Grammaire</span>
      <span aria-hidden="true">→</span>
    </button>
  </div>
</section>
