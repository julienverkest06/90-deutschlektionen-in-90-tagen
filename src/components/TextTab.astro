---
---

<section id="tab-content-text" class="space-y-6 animate-pop">
  <div class="bg-white rounded-2xl border border-gray-200 p-5 sm:p-6 shadow-xs">
    <div class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-5 border-b border-gray-100">
      <div>
        <h3 class="font-bold text-base text-de-black">Texte allemand et traduction juxtalinéaire</h3>
        <p class="text-xs text-gray-500">
          Cliquez sur un paragraphe ou le bouton haut-parleur pour écouter la prononciation allemande.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <button
          id="speak-full-lesson-btn"
          type="button"
          class="px-3.5 py-2 rounded-xl bg-de-black hover:bg-gray-800 text-white text-xs font-semibold flex items-center gap-2 transition shadow-xs cursor-pointer"
        >
          <span>🔊</span>
          <span>Tout écouter</span>
        </button>
        <button
          id="toggle-trans-btn"
          type="button"
          class="px-3 py-2 rounded-xl border border-gray-200 hover:bg-gray-50 text-xs font-semibold text-gray-700 transition cursor-pointer"
        >
          Masquer français
        </button>
      </div>
    </div>

    <div id="lesson-paragraphs" class="space-y-4"></div>
  </div>

  <!-- Note de Prononciation -->
  <div id="pronunciation-card" class="bg-amber-50/70 rounded-2xl border border-amber-200/80 p-5">
    <div class="flex items-center gap-2 mb-2">
      <span class="text-lg">🗣️</span>
      <h4 class="font-bold text-sm text-amber-950">Prononciation & Accent tonique</h4>
    </div>
    <p id="lesson-pronunciation" class="text-xs sm:text-sm text-amber-900 leading-relaxed"></p>
  </div>

  <div class="flex justify-end">
    <button
      data-switch-tab="vocab"
      type="button"
      class="px-5 py-3 rounded-xl bg-de-black hover:bg-gray-800 text-white text-sm font-bold transition flex items-center gap-2 shadow-xs cursor-pointer"
    >
      <span>Continuer vers le Vocabulaire & la Grammaire</span>
      <span>→</span>
    </button>
  </div>
</section>
