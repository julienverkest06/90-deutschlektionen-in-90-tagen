---
---

<!-- Modale Trophées & Badges -->
<div id="badges-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/50 backdrop-blur-xs">
  <div class="bg-white max-w-lg w-full p-6 border border-stone-400 animate-pop max-h-[85vh] flex flex-col">
    <div class="flex items-center justify-between pb-3 border-b border-stone-200">
      <div class="flex items-center gap-2.5">
        <span class="text-xl text-de-gold leading-none" aria-hidden="true">♛</span>
        <h3 class="font-serif font-bold text-xl text-de-black">Salle des Trophées — Méthode 90</h3>
      </div>
      <button data-close-badges type="button" class="px-2 py-1 hover:bg-stone-100 text-stone-600 cursor-pointer" aria-label="Fermer">
        ✕
      </button>
    </div>
    <div id="badges-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3 overflow-y-auto py-4"></div>
    <div class="pt-3 border-t border-stone-200 flex justify-end">
      <button data-close-badges type="button" class="px-4 py-2 bg-de-black hover:bg-stone-800 text-de-cream text-xs font-bold tracking-wide cursor-pointer">
        Fermer
      </button>
    </div>
  </div>
</div>

<!-- Boîte de dialogue personnalisée (jamais alert/confirm) -->
<div id="custom-dialog" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/50 backdrop-blur-xs">
  <div class="bg-white max-w-sm w-full p-6 border border-stone-400 animate-pop">
    <h4 id="dialog-title" class="font-serif font-bold text-lg text-de-black mb-2">Confirmation</h4>
    <p id="dialog-message" class="text-sm text-stone-600 mb-5"></p>
    <div id="dialog-actions" class="flex justify-end gap-2"></div>
  </div>
</div>
