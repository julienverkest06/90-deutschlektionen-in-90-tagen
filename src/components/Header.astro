---
---

<header class="sticky top-1 z-40 bg-white/95 backdrop-blur border-b border-stone-300">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 h-16 flex items-center justify-between gap-2">
    <!-- Gauche : Bouton menu mobile + Titre éditorial -->
    <div class="flex items-center gap-3">
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2 border border-stone-300 hover:bg-stone-100 text-de-black transition cursor-pointer"
        aria-label="Ouvrir le sommaire"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <button
        id="brand-home-btn"
        type="button"
        class="flex items-center gap-3 cursor-pointer text-left"
      >
        <div class="w-9 h-9 bg-de-black text-de-cream flex items-center justify-center font-serif font-bold text-lg border-b-2 border-de-red">
          90
        </div>
        <div class="hidden sm:block">
          <h1 class="font-serif font-bold text-base sm:text-lg leading-tight tracking-tight text-de-black">
            L'allemand en 90 leçons
          </h1>
          <p class="text-[11px] text-stone-500 font-medium tracking-wide">Méthode 90 · Alphonse Jenny</p>
        </div>
      </button>
    </div>

    <!-- Centre / Droite : Statistiques Gamification -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Niveau & Barre d'XP -->
      <div class="flex items-center gap-2.5 bg-de-cream border border-stone-300 px-3 py-1.5 relative">
        <div class="flex flex-col">
          <div class="flex items-center justify-between gap-3">
            <span id="player-rank" class="text-xs font-bold text-de-black truncate max-w-[110px] sm:max-w-none">
              Débutant à Cologne
            </span>
            <span id="player-xp-text" class="text-[11px] font-semibold text-de-red">0 XP</span>
          </div>
          <div class="w-24 sm:w-36 h-1.5 bg-stone-200 overflow-hidden mt-1">
            <div
              id="player-xp-bar"
              class="h-full bg-de-black transition-all duration-500"
              style="width: 0%"
            ></div>
          </div>
        </div>
        <div id="xp-popup-anchor" class="absolute -bottom-6 right-2 pointer-events-none"></div>
      </div>

      <!-- Série (Streak) -->
      <div class="flex items-center gap-1.5 bg-de-cream border border-stone-300 px-2.5 py-1.5" title="Série quotidienne">
        <span class="text-sm leading-none text-de-gold" aria-hidden="true">✶</span>
        <span id="player-streak" class="text-xs sm:text-sm font-bold text-de-black tabular-nums">1</span>
      </div>

      <!-- Vies / Énergie -->
      <div class="hidden md:flex items-center gap-1.5 bg-de-cream border border-stone-300 px-2.5 py-1.5" title="Cœurs d'énergie">
        <span class="text-sm leading-none text-de-red" aria-hidden="true">❦</span>
        <span id="player-hearts" class="text-xs sm:text-sm font-bold text-de-black tabular-nums">5</span>
      </div>

      <!-- Bouton Trophées / Badges -->
      <button
        id="open-badges-btn"
        type="button"
        class="flex items-center gap-2 bg-de-black hover:bg-stone-800 text-de-cream border border-de-black px-3 py-2 text-xs font-semibold tracking-wide transition cursor-pointer"
      >
        <span class="text-de-gold leading-none" aria-hidden="true">♛</span>
        <span class="hidden sm:inline">Trophées</span>
        <span id="badges-count" class="bg-de-cream text-de-black text-[10px] font-extrabold px-1.5 py-0.5 tabular-nums">0</span>
      </button>
    </div>
  </div>
</header>
