---
---

<section id="tab-content-vocab" class="hidden space-y-6 animate-pop">
  <!-- Flashcards interactives -->
  <div class="bg-white rounded-2xl border border-gray-200 p-5 sm:p-6 shadow-xs">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h3 class="font-bold text-base text-de-black">Cartes Mémoire (Vocabulaire clé)</h3>
        <p class="text-xs text-gray-500">
          Cliquez sur une carte pour révéler la traduction, ou sur 🔊 pour l'écouter.
        </p>
      </div>
      <span id="vocab-count-badge" class="text-xs font-bold px-2.5 py-1 rounded-lg bg-gray-100 text-gray-700">
        0 termes
      </span>
    </div>

    <div id="vocab-cards-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3"></div>
  </div>

  <!-- Règles de Grammaire -->
  <div class="bg-white rounded-2xl border border-gray-200 p-5 sm:p-6 shadow-xs">
    <div class="flex items-center gap-2.5 mb-4 pb-3 border-b border-gray-100">
      <span class="w-7 h-7 rounded-lg bg-de-red text-white flex items-center justify-center font-bold text-sm">G</span>
      <h3 class="font-bold text-base text-de-black">Grammaire de la leçon</h3>
    </div>
    <div id="lesson-grammar-content" class="space-y-4 text-sm text-gray-700 leading-relaxed"></div>
  </div>

  <div class="flex items-center justify-between">
    <button
      data-switch-tab="text"
      type="button"
      class="px-4 py-2.5 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 text-xs sm:text-sm font-semibold text-gray-700 transition cursor-pointer"
    >
      ← Retour au Texte
    </button>
    <button
      data-switch-tab="arena"
      type="button"
      class="px-5 py-3 rounded-xl bg-de-red hover:bg-de-red-dark text-white text-sm font-bold transition flex items-center gap-2 shadow-sm cursor-pointer"
    >
      <span>⚔️ Entrer dans l'Arène d'Exercices</span>
    </button>
  </div>
</section>
